DATABASE_URL=postgres://user:pass@host:5432/db
DART_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 선택. 설정하면 일일 다이제스트와 연속 실패 알림이 이 채널로만 간다.
# 공개 전환 시 필수 — 없으면 운영 정보가 구독자에게 방송된다.
TELEGRAM_OPERATOR_CHAT_ID=
LLM_API_KEY=
HEARTBEAT_URL=
# 선택 — 비워두면 안전하게 기본값 20,000이 적용된다. 계정에 발급된 일일 호출
# 한도이며, 기본값은 OpenDART 문서상 기본 한도인 20,000 — 다르게 발급받은
# 계정만(예: 40,000) 채운다.
DART_DAILY_LIMIT=
# 뉴스 소스 (3단계). 기본은 꺼짐 — 배포와 활성화를 분리한다.
NEWS_ENABLED=false
# RSS 폴링 주기(ms). 반영 지연이 중앙값 3.5분이고 조건부 요청이 5곳 중 1곳에서만
# 먹어 나머지는 매번 전문을 다시 받는다 — 30초면 하루 1.2GB, 60초면 0.6GB다.
NEWS_INTERVAL_MS=60000
# 90일 보관 정리 (3b). 기본은 꺼짐 — **켜면 되돌릴 수 없다.** 90일 지난 events 와
# 종결된(sent/dead) outbox 행을 매일 KST 자정 이후 첫 사이클에 영구 삭제하며,
# 지운 행은 어디에도 남지 않는다. 주간 덤프 백업(.github/workflows/backup.yml)을
# 최소 한 번 실제로 돌려 아티팩트의 행 수를 확인한 **뒤에** true 로 바꾼다.
# 꺼져 있으면 기동 로그에 'retention disabled' 가 한 줄 찍힌다 — 침묵이 "꺼짐"인지
# "고장"인지 구별하기 위한 신호다.
RETENTION_ENABLED=false
